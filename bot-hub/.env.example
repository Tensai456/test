# คัดลอกเป็น .env แล้วแก้ · ห้าม commit .env (มี token)
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.21.9          # [ไม่แน่ใจ] ใส่เวอร์ชันที่ ViaVersion รับ (แล็บใช้โปรโตคอล 26.1) — ว่าง = ให้ mineflayer เดา
MC_AUTH=offline            # offline | microsoft
MC_LAB_PATH=../mc-lab      # ที่อยู่สมองกฎ (decide) + adapter

HUB_HOST=127.0.0.1         # 0.0.0.0 = เปิดให้เครื่องอื่นใน LAN เข้า (ต้องตั้ง HUB_TOKEN ด้วย)
HUB_PORT=8787
HUB_TOKEN=                 # ว่าง = ไม่ล็อก (ใช้ได้เฉพาะ 127.0.0.1)

# สมองที่ต้องเสียบเอง (ไฟล์ .mjs ที่ export decide(state, goal)) — ดู brains/README.md
OLD_BRAIN_PATH=            # สมองเดิม (qwen3:8b + กฎ)
FLY_SMALL_PATH=            # สมองแมลงวันเล็ก
FLY_FULL_PATH=             # FlyWire เต็ม

# คำสั่งในเกม (ต้องมีปลั๊กอิน) · {skin} {name} {login} ถูกแทนค่า
SKIN_CMD=/skin set {skin}  # SkinsRestorer [ไม่แน่ใจ ไวยากรณ์ตามเวอร์ชันปลั๊กอิน]
NICK_CMD=                  # EssentialsX: /nick {name} · ว่าง = ไม่เปลี่ยนชื่อในเกม

# Discord (ไม่ใส่ = ไม่เปิดบอต Discord)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# แปลงเสียง→ข้อความ: คำสั่งที่อ่าน {wav} แล้วพิมพ์ข้อความออก stdout · {prompt} = รายชื่อบอต (ช่วยให้ STT สะกดชื่อถูก)
STT_CMD=whisper-cli -m models/ggml-large-v3-turbo.bin -l th -nt -np --prompt "{prompt}" -f {wav}
